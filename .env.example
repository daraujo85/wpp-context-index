# Path overrides for the machine-wide WhatsApp allowlist files (not project
# secrets — read from the user's home dir).
# WHATSAPP_ENV_PATH=~/.claude/secrets/whatsapp.env
# WHATSAPP_LIDS_PATH=~/.claude/secrets/whatsapp-lids.json

VISION_MODEL=gemma4:12b
EMBEDDING_MODEL=nomic-embed-text
TEXT_MODEL=qwen3:8b
# Container-perspective (this file feeds docker-compose's env substitution
# too, per README's "cp .env.example .env" step) — host.docker.internal
# resolves the Docker host's Ollama from inside the wpp-context container
# on macOS/Windows Docker Desktop. Host-run code (pytest, cron script) uses
# localhost instead — see scripts/ingest-yesterday.sh's explicit export.
OLLAMA_BASE_URL=http://host.docker.internal:11434
QDRANT_URL=http://qdrant:6333
INGEST_CONCURRENCY=1
MEDIA_CONCURRENCY=1
CONVERSATION_GAP_MINUTES=20

# Max size (MB) for a single media download before get_media() raises
# WppMediaTooLargeError instead of proceeding (PRD §21 media size limits).
MEDIA_MAX_SIZE_MB=25
